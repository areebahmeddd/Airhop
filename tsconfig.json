{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "types": ["jest"],
    "paths": {
      "@app/*": ["./src/app/*"],
      "@bridge/*": ["./src/bridge/*"],
      "@core/*": ["./src/core/*"],
      "@data/*": ["./src/data/*"],
      "@features/*": ["./src/features/*"],
      "@i18n": ["./src/i18n"],
      "@i18n/*": ["./src/i18n/*"],
      "@platform/*": ["./src/platform/*"],
      "@services/*": ["./src/services/*"],
      "@store/*": ["./src/store/*"],
      "@ui/*": ["./src/ui/*"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "include": ["App.tsx", "src/**/*", "*.ts", "*.tsx"]
}
