{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["pod-install"],
  "ignoreDependencies": ["expo-updates"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "App.tsx",
        "src/**/__tests__/**/*.{ts,tsx}",
        "src/**/__benchmarks__/**/*.bench.ts",
        "scripts/*.js",
        "press/build.mjs",
        "press/tools/*.mjs"
      ],
      "project": ["src/**/*.{ts,tsx,js}", "scripts/**/*.js", "press/**/*.mjs"]
    },
    "landing": {
      "project": ["src/**/*.{ts,tsx,css}", "plugins/**/*.ts"]
    }
  }
}
