<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Airhop</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>org.onemindlabs.airhop</string>
				<string>airhop</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Export compliance. Apple ships every app from the United States, so US
	     export rules attach to it whoever wrote it and wherever they live.

	     Read the key name carefully: it asks about NON-EXEMPT encryption, not
	     about encryption. Airhop plainly uses encryption, but under the EAR that
	     is only "non-standard cryptography" when the algorithm is proprietary or
	     unpublished. Every primitive here is a published standard - X25519
	     (RFC 7748), Ed25519 (RFC 8032), ChaCha20-Poly1305 (RFC 8439), SHA-256,
	     HKDF (RFC 5869), secp256k1 Schnorr (BIP-340) - composed by published
	     specifications: the Noise Protocol Framework, Signal's Double Ratchet,
	     and NIP-44. Nothing is invented here.

	     Publicly available encryption source code performing standard
	     cryptography is not subject to the EAR, and since a 2021 BIS rule it
	     carries no notification requirement either; that survives only for
	     non-standard cryptography. The repository being public under MIT is what
	     satisfies it, so there is nothing to file and nothing to renew.

	     What this does depend on is the source staying public. If Airhop is ever
	     closed, forked privately, or ships a binary whose source is not
	     published, this answer stops being true and has to be revisited. -->

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The App Store category, matching bitchat's. Set here as well as in App
	     Store Connect so the bundle is self-describing and the two cannot
	     disagree. LSMinimumSystemVersion used to sit next to this at 12.0; it is
	     a macOS key that iOS ignores, it came from the template, and the real
	     floor is IPHONEOS_DEPLOYMENT_TARGET in the Xcode project. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.social-networking</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Airhop uses Bluetooth to communicate with nearby devices on the mesh.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Airhop uses Bluetooth to advertise your presence to nearby peers.</string>
	<!-- Camera, microphone, photo library and location. Every usage string below
	     is also declared in app.json. This file is hand-maintained rather than
	     regenerated, so adding a permission to app.json alone changes nothing
	     here: add it in both places.

	     These are not optional. Without them iOS does not deny the request - it
	     terminates the process the moment AVCaptureDevice or AVAudioSession is
	     touched. -->
	<key>NSCameraUsageDescription</key>
	<string>Airhop uses the camera to scan a contact's QR code, and to capture photos and videos to share with nearby peers.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Airhop uses the microphone to record voice notes and to carry live voice to nearby peers.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Airhop accesses your photo library to share images and videos over the mesh.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Airhop saves photos and videos to your photo library when you choose to save one, and when you download your QR code.</string>
	<!-- Location resolves which geohash cell the location channels (#block,
	     #city, #region, and so on) belong to. Raw coordinates never leave the
	     device; only the truncated geohash is published. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Airhop uses your approximate location to place you in nearby area channels (block, city, region). Your exact position never leaves your device.</string>
	<!-- No local-network keys. iOS has no same-platform fast path: the
	     MultipeerConnectivity module was removed, so nothing here browses or
	     advertises on the local network and asking for that permission would be
	     a prompt with nothing behind it. -->
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>SplashScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	<!-- Portrait only, matching app.json's orientation and the Android
	     activity's screenOrientation. Upside-down came from the template; most
	     iPhones refuse it anyway, so allowing it only meant the two platforms
	     disagreed on paper. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Automatic</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
