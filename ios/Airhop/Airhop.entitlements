<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Wi-Fi Aware, for the same-platform fast path (AirhopWiFiModule.swift).

         Both values, because Airhop is symmetric: every device publishes the
         service so it can be found and subscribes to it so it can find, and the
         transport runs a listener and a browser at once.

         This is a managed capability. Declaring it here does not grant it: the
         capability has to be enabled for the App ID and present in the
         provisioning profile before the app can be signed, and the framework
         refuses at runtime otherwise. A build without it still runs the mesh,
         because the fast path is an accelerator and Bluetooth carries
         everything. -->
    <key>com.apple.developer.wifi-aware</key>
    <array>
      <string>Publish</string>
      <string>Subscribe</string>
    </array>
  </dict>
</plist>
