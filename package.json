{
  "name": "airhop",
  "version": "1.0.0",
  "description": "Private, offline-first messenger",
  "keywords": [
    "airhop",
    "messenger",
    "bluetooth",
    "p2p",
    "mesh-network",
    "offline-communication",
    "encrypted",
    "nostr",
    "cashu"
  ],
  "author": "Areeb Ahmed <hi@areeb.dev>",
  "license": "MIT",
  "homepage": "https://airhop.1mindlabs.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/areebahmeddd/airhop"
  },
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "prebuild": "expo prebuild",
    "test": "jest --watchAll",
    "coverage": "jest --passWithNoTests --coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cashu/cashu-ts": "^4.7.2",
    "@expo-google-fonts/fira-code": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "expo": "~57.0.9",
    "expo-audio": "~57.0.3",
    "expo-build-properties": "~57.0.8",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-manipulator": "~57.0.7",
    "expo-image-picker": "~57.0.7",
    "expo-location": "^57.0.7",
    "expo-media-library": "^57.0.3",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.8",
    "expo-screen-capture": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-video": "~57.0.2",
    "nostr-tools": "^2.24.1",
    "pako": "^2.2.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-encrypted-storage": "^4.0.3",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.3",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/jest": "29.5.14",
    "@types/pako": "^2.0.4",
    "@types/react": "~19.2.17",
    "@typescript-eslint/parser": "^8.65.0",
    "babel-preset-expo": "~57.0.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "expo-audio": true,
    "react-native-get-random-values": true,
    "react-native-nitro-modules": true,
    "react-native-reanimated": true,
    "react-native-worklets": true
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.[jt]s?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@noble|@scure|nostr-tools|@cashu|react-native|@react-native|expo|@expo|@unimodules|unimodules|react-native-reanimated))"
    ],
    "moduleNameMapper": {
      "^@noble/curves/(.+?)(\\.js)?$": "<rootDir>/node_modules/@noble/curves/$1.js",
      "^@noble/hashes/(.+?)(\\.js)?$": "<rootDir>/node_modules/@noble/hashes/$1.js",
      "^@noble/ciphers/(.+?)(\\.js)?$": "<rootDir>/node_modules/@noble/ciphers/$1.js",
      "^react-native-encrypted-storage$": "<rootDir>/src/__mocks__/react-native-encrypted-storage.js"
    }
  }
}
