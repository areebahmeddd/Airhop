# Every input that decides what the shipped Tor binaries contain.
#
# Sourced by the Dockerfile and by both build scripts, so there is one place to
# change a version and no way for the container and the scripts to disagree.
# Changing anything here changes the binaries, which changes SHA256SUMS, which
# fails CI until the manifest is regenerated in the same commit. That is the
# point: a native binary must never move without a reviewable reason.

# The Tor implementation. Matches the arti-client version in Cargo.toml, which
# Cargo.lock pins exactly along with its whole dependency graph.
ARTI_CLIENT_VERSION=0.45.0

# Rust. Mirrored in rust-toolchain.toml so a local build cannot silently use a
# different compiler from the container.
RUST_VERSION=1.98.0

CARGO_NDK_VERSION=4.1.2

# Android NDK r27d, the long-term-support release of the r27 line.
#
# Chosen to match the app rather than to be newest. React Native 0.86 builds
# every other native library in the APK with NDK 27.1, so r27d keeps the Tor
# library on the same NDK major line, the same libc headers and the same API
# level behaviour as the code it ships beside, and takes the latest patch of
# that line rather than an arbitrary point in it.
#
# r28 and later align load segments to 16 KiB by default where r27 needs a
# linker flag, which sounds like a reason to jump ahead and is not: cargo-ndk 4
# passes the flag, and build-android.sh reads the alignment back with readelf
# rather than trusting any default. Verified at 0x4000 on this toolchain. So the
# only thing moving to r29 would buy is being two NDK majors ahead of everything
# else in the same APK.
#
# The checksum is the value published by Google, independently confirmed against
# the same archive used by the bitchat Android build.
ANDROID_NDK_VERSION=27.3.13750724
ANDROID_NDK_ARCHIVE=android-ndk-r27d-linux.zip
ANDROID_NDK_SHA256=601246087a682d1944e1e16dd85bc6e49560fe8b6d61255be2829178c8ed15d9

# Google Play requires 16 KiB page alignment on 64-bit libraries. Verified after
# every build; one that does not satisfy it fails the build rather than the
# store review. 32-bit ABIs are exempt, because every device with 16 KiB pages
# is 64-bit.
REQUIRED_LOAD_ALIGNMENT=16384

# The lowest Android release Airhop supports, so the native libraries are built
# against the same API floor as the app. Mirrors android.minSdkVersion in
# android/gradle.properties.
ANDROID_MIN_SDK=26

# Apple deployment floors. iOS 16.4 matches the existing Arti podspec; macOS is
# built only so the slice exists for tooling and simulator work on Apple silicon.
IOS_MIN_VERSION=16.4
MACOS_MIN_VERSION=13.0

# An immutable Debian archive, so the container's system packages are the same
# bytes on every rebuild rather than whatever the mirror serves that day.
DEBIAN_SNAPSHOT=20260720T000000Z

# Frozen build timestamp, so nothing records the moment it was compiled. Set to
# the arti 0.45.0 release date, which is a date with a reason rather than an
# arbitrary constant.
NATIVE_SOURCE_DATE_EPOCH=1785715200
