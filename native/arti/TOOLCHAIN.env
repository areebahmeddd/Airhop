# Inputs that determine the shipped Tor binaries.
# Used by the Dockerfile and build scripts to keep versions in sync.
# Changes here require regenerating SHA256SUMS in the same commit.

# Tor implementation version. Must match arti-client in Cargo.toml.
ARTI_CLIENT_VERSION=0.45.0

# Rust version. Must match rust-toolchain.toml.
RUST_VERSION=1.98.0

# cargo-ndk version. Required for the 16 KiB alignment flags used with NDK r27.
# build-android.sh enforces this exact version.
CARGO_NDK_VERSION=4.1.2

# Android NDK r27d. Kept on the same NDK major line as the app's native builds.
# cargo-ndk passes the required 16 KiB alignment flag; build-android.sh verifies
# the resulting load alignment with readelf.
#
# SHA256 published by Google and verified against the archive used by the
# bitchat Android build.
ANDROID_NDK_VERSION=27.3.13750724
ANDROID_NDK_ARCHIVE=android-ndk-r27d-linux.zip
ANDROID_NDK_SHA256=601246087a682d1944e1e16dd85bc6e49560fe8b6d61255be2829178c8ed15d9

# Required load-segment alignment for 64-bit Android libraries.
# Verified after every build.
REQUIRED_LOAD_ALIGNMENT=16384

# Minimum Android API level. Must match android.minSdkVersion in
# android/gradle.properties.
ANDROID_MIN_SDK=26

# Minimum iOS deployment version. Must match ios/Arti.podspec.
# No macOS slice; see SIM_TARGETS in build-apple.sh.
IOS_MIN_VERSION=16.4

# Debian snapshot used for reproducible system packages.
DEBIAN_SNAPSHOT=20260720T000000Z

# Fixed build timestamp for reproducible builds.
# Set to the arti 0.45.0 release date.
NATIVE_SOURCE_DATE_EPOCH=1785715200
