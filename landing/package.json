{
  "name": "airhop-landing",
  "version": "1.0.0",
  "description": "Landing page for Airhop, a private offline-first peer-to-peer messaging app over Bluetooth mesh.",
  "keywords": [
    "airhop",
    "bluetooth",
    "mesh",
    "p2p",
    "privacy",
    "offline"
  ],
  "author": "Areeb Ahmed <hi@areeb.dev>",
  "license": "MIT",
  "homepage": "https://airhop.1mindlabs.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/areebahmeddd/airhop"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "start": "vite preview",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "format": "prettier --write \"{src/**/*.{ts,tsx,css},plugins/**/*.ts,public/**/*.js,*.{js,ts,json,md},index.html}\"",
    "format:check": "prettier --check \"{src/**/*.{ts,tsx,css},plugins/**/*.ts,public/**/*.js,*.{js,ts,json,md},index.html}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  }
}
