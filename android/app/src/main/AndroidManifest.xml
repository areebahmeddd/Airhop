<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- Location is for LOCATION CHANNELS, not for Bluetooth.

       This was a hard mesh prerequisite while BLUETOOTH_SCAN carried no
       neverForLocation flag, which cost two things: a backgrounded app is not
       foreground-for-location without a `location`-typed service, so scan
       results were withheld exactly when the notification claimed otherwise,
       and choosing "Approximate" left the mesh unable to find anyone.

       BLE needs no location from API 31 (see the flag below). Location is
       requested only when a location channel is opened.

       FINE stays unrestricted rather than capped at API 30: #block is geohash
       precision 7 (~150 m) and a coarse fix is snapped to a far larger grid, so
       a COARSE-only build would place people in the wrong cell. On API <=30
       both are still required for BLE; utils/ble-permissions.ts knows the
       difference. -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
  <uses-permission android:name="android.permission.BLUETOOTH"/>
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>
  <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"/>
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
  <!-- neverForLocation: Airhop derives no physical location from a scan result.
       It reads the service UUID, the 8-byte peer ID in the scan response, and
       RSSI for the radar ring, none of which is a position. Asserting it
       decouples the mesh from the location permission and the OS toggle on API
       31+, which is what makes background discovery work. The system scrubs
       iBeacon and Eddystone payloads in exchange; Airhop's own 128-bit service
       data is untouched, so discovery and bitchat interop are unaffected. -->
  <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"/>
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <!-- Required for Android 14+ to keep BLE active in a foreground service -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
  <!-- Android 13+ (API 33) runtime permission for WiFi Aware discovery. The
       same-platform WiFi fast path is optional, so a denial never blocks the
       BLE mesh. On API <=32 the location permissions above already cover it.

       neverForLocation for the same reason as BLUETOOTH_SCAN: a WiFi Aware peer
       handle is an opaque discovery token, not a position. bitchat/android
       declares the flag here too. -->
  <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation"/>
  <!-- Android 17 gates local network access behind a runtime permission, and a
       WiFi Aware data path is a raw socket over a link-local IPv6 address, so
       it counts. Opt-in on Android 16 and enforced for apps targeting 17, which
       this one does not yet - declared now so the targetSdk bump does not
       silently break the fast path. It sits in the NEARBY_DEVICES group beside
       NEARBY_WIFI_DEVICES, so granting one covers the other and the user sees
       no second dialog. -->
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK"/>
  <!-- Android 13+ runtime permission for local message notifications -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <!-- Hands a downloaded release APK to the system installer, for the update
       path on the Version screen. An offline-first app whose users may have no
       reachable store cannot depend on one to ship a fix.

       Buys nothing but the right to OPEN the installer. The user confirms in a
       system dialog, Android wants "Install unknown apps" allowed for Airhop on
       top of that, and it refuses any APK not signed by our release key, so
       this cannot deliver a build that is not ours.

       Strip it, and the screen's download path with it, in any Play-distributed
       flavour: Play's Device and Network Abuse policy forbids an app shipped
       there from updating itself by any route but Play. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
  <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
  <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
  <!-- Hardware Airhop needs, stated explicitly.

       Google Play hides an app from devices that lack a feature declared
       required="true", and it INFERS required features from permissions unless
       we say otherwise. Left alone, that inference is backwards for this app:
       CAMERA implies a rear autofocus camera and RECORD_AUDIO implies a
       microphone, so Play was filtering out hardware the mesh runs fine on,
       while nothing implied Bluetooth LE - the one thing Airhop cannot work
       without. Every line below either corrects that or makes an existing
       implication explicit. bitchat/android declares the same set.

       Bluetooth LE is the mesh. Without it the app has no offline transport at
       all, so an install on such a device is a broken install. BLUETOOTH and
       BLUETOOTH_ADMIN above already imply android.hardware.bluetooth; it is
       repeated here so the requirement is readable rather than inferred. -->
  <uses-feature android:name="android.hardware.bluetooth" android:required="true"/>
  <uses-feature android:name="android.hardware.bluetooth_le" android:required="true"/>
  <!-- The camera scans contact QR codes and captures attachments. Both are
       optional paths: a contact can be added from a link or by hand, and
       attachments can be picked from the library. Autofocus is implied by the
       CAMERA permission and is not needed at all, so both are released. -->
  <uses-feature android:name="android.hardware.camera" android:required="false"/>
  <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
  <!-- The microphone records voice notes and push-to-talk. Messaging works
       without either, so a device with no microphone should still install. -->
  <uses-feature android:name="android.hardware.microphone" android:required="false"/>
  <!-- WiFi Aware powers the optional same-platform (Android-to-Android) fast
       path. required="false" so phones without WiFi Aware hardware, and iPhones,
       still install and run on the BLE mesh. -->
  <uses-feature android:name="android.hardware.wifi.aware" android:required="false"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
    <!-- Package visibility (Android 11+) so PackageManager can tell whether
         Orbot is installed when the user enables Tor routing. -->
    <package android:name="org.torproject.android"/>
  </queries>
  <!-- enableOnBackInvokedCallback stays FALSE, and is not an oversight.

       React Native 0.86's ReactActivity registers its OnBackPressedCallback only
       when the DEVICE is API 36+ and the app targets 36+ (see
       AndroidVersion.isAtLeastTargetSdk36). On API 36 the platform enforces
       predictive back and ignores this flag anyway, so BackHandler keeps working.

       Below API 36 the flag decides. Setting it true would have AndroidX route
       back into OnBackPressedDispatcher, bypassing ReactActivity's
       onBackPressed() override - the only thing that reaches BackHandler - and
       with no RN callback registered there the dispatcher falls through to
       Activity.super.onBackPressed(). In-thread back, search cancel and the
       profile back handler would close the app on Android 13, 14 and 15.

       Revisit when React Native registers its callback unconditionally. -->
  <!-- Puts Airhop under Settings > Apps > Airhop > Language on Android 13, so
       someone whose system language Airhop does not ship can still pick one it
       does. Reaches only the strings the OS renders. Inert below API 33. -->
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="false" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false" android:requestLegacyExternalStorage="true" android:localeConfig="@xml/locales_config" tools:targetApi="33">
    <!-- Android 16 ignores screenOrientation, resizability and aspect-ratio
         restrictions on any display at least 600dp wide, so the portrait lock on
         MainActivity below stops applying on a foldable's inner screen, a tablet
         or a desktop window. The four-tab shell in App.tsx has no breakpoints and
         is laid out for a phone in portrait, so being handed a large resizable
         window is a worse experience than compatibility mode, not a better one.

         This buys time on Android 16 only, and the expiry is earlier than it
         looks: the opt-out was removed in Android 17, so it stops applying on an
         Android 17 device at this targetSdk, not only once targetSdk reaches 37.

         Verified on a Pixel 10 Pro Fold: the activity gets the full 851dp inner
         display with no pillarboxing. It renders correctly, so this is a polish
         gap rather than a break; the MAX_CANVAS cap in radar-view.tsx exists
         because of that test. -->
    <property android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY" android:value="true"/>
    <!-- Read by expo-notifications at runtime. Written here rather than through
         the config plugin because prebuild is never run in this repo, so the
         plugin's app.json options would generate nothing. Without them a
         notification falls back to the launcher icon, which Android renders
         through its mask as a white blob. AirhopForegroundService uses the same
         pair so the two notices look like one app. -->
    <meta-data android:name="expo.modules.notifications.default_notification_icon" android:resource="@drawable/notification_icon"/>
    <meta-data android:name="expo.modules.notifications.default_notification_color" android:resource="@color/notification_icon_color"/>
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.ENABLE_BSDIFF_PATCH_SUPPORT" android:value="true"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <!-- expo-audio's AudioControlsService and FOREGROUND_SERVICE_MEDIA_PLAYBACK
         were written here by a past prebuild and are deliberately gone. That
         service starts from one call, AudioPlayer.setActiveForLockScreen(),
         which Airhop never makes. Carrying it cost a second Play
         foreground-service declaration, each needing its own screen recording,
         for a service that can never start.

         If lock-screen controls are ever wanted, the permission and this block
         come back TOGETHER; removing one alone is a crash on Android 14+. Until
         then the call degrades to an expo-audio error log. -->
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|assetsPaths" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <!-- Airhop deep links: airhop://channel/<name>, airhop://peer/<id> -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="airhop"/>
      </intent-filter>
    </activity>
    <!-- Foreground service that keeps BLE scanning/advertising alive in the background -->
    <service
      android:name="org.onemindlabs.airhop.service.AirhopForegroundService"
      android:foregroundServiceType="connectedDevice"
      android:exported="false"/>
  </application>
</manifest>